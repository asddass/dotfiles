# Auto-detect text files and normalize line endings
* text=auto

# Enforce LF for Linux/Unix scripts and shell configs
*.sh text eol=lf
*.bash text eol=lf
.bashrc* text eol=lf

# Enforce CRLF for Windows PowerShell scripts and batch files
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Documentation
*.md text eol=lf